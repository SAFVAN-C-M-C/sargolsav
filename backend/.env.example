HOST=127.0.0.1
PORT=3001
# Comma-separated browser origins; omit trailing slashes. Credentials are disabled.
CORS_ORIGIN=http://localhost:5173

# PostgreSQL: DATABASE_URL takes precedence over individual connection fields.
# Never commit a real connection URL or password.
PGHOST=localhost
PGPORT=5432
PGDATABASE=sargolsav
PGUSER=postgres
PGPASSWORD=
# Use verify-full for hosted PostgreSQL with a trusted TLS certificate.
PGSSLMODE=disable
PGPOOL_MAX=5
PGCONNECT_TIMEOUT_MS=5000
PGIDLE_TIMEOUT_MS=30000
PGSTATEMENT_TIMEOUT_MS=10000
PGQUERY_TIMEOUT_MS=15000
PGTRANSACTION_IDLE_TIMEOUT_MS=15000
