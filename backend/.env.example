HOST=127.0.0.1
PORT=3001
# Comma-separated browser origins; omit trailing slashes. Credentials are disabled.
CORS_ORIGIN=http://localhost:5173

# Firebase Admin (backend only). Create an existing Firebase Authentication user
# before manually granting admin. Keep service-account JSON outside this repository.
FIREBASE_PROJECT_ID=
# For local/on-premises ADC, set this to the absolute path of a service-account
# JSON key. On Google hosting, prefer workload identity and leave it unset.
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\outside\repo\service-account.json
# Alternatively, supply these two fields from the Firebase service-account JSON
# through a backend secret store. Use the private_key PEM value with escaped \n.
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# PostgreSQL: DATABASE_URL takes precedence over individual connection fields.
# Never commit a real connection URL or password.
PGHOST=localhost
PGPORT=5432
PGDATABASE=sargolsav
PGUSER=postgres
PGPASSWORD=
# Use verify-full for hosted PostgreSQL with a trusted TLS certificate.
PGSSLMODE=disable
PGPOOL_MAX=5
PGCONNECT_TIMEOUT_MS=5000
PGIDLE_TIMEOUT_MS=30000
PGSTATEMENT_TIMEOUT_MS=10000
PGQUERY_TIMEOUT_MS=15000
PGTRANSACTION_IDLE_TIMEOUT_MS=15000
