{
  "name": "@sargolsav/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --ext js,json --exec \"node --env-file-if-exists=.env\" src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "test": "node --test --test-concurrency=2",
    "admin:claim": "node --env-file-if-exists=.env src/auth/provision-admin.js",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate-cli.js",
    "db:seed": "node --env-file-if-exists=.env src/db/seed-cli.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.1.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
